    "express": "^4.19.2",
    "mysql2": "^3.10.2",
    "node-telegram-bot-api": "^0.66.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "telegram-webapps-types": "^1.0.5",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^16.18.101",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.5"
  },
